name: Unzip NAJI into Repository

on:
  workflow_dispatch:

jobs:
  unzip:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Unzip NAJI
        run: |
          unzip -q naji-android-ready-updated.zip -d extracted_app

          APP_DIR=""

          if [ -d "extracted_app/naji" ]; then
            APP_DIR="extracted_app/naji"
          else
            APP_DIR="$(find extracted_app -mindepth 1 -maxdepth 1 -type d | head -n 1)"
          fi

          if [ -z "$APP_DIR" ] || [ ! -f "$APP_DIR/package.json" ]; then
            echo "App directory not found"
            find extracted_app -maxdepth 3 -print
            exit 1
          fi

          shopt -s dotglob
          cp -a "$APP_DIR"/. .

          rm -rf extracted_app
          rm -f naji-android-ready-updated.zip

      - name: Commit extracted files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add -A
          git commit -m "Extract NAJI app and remove ZIP" || echo "No changes to commit"
          git push
